{
  "rewrites": [
    { "source": "/r/:code", "destination": "/api/r?c=:code" },
    { "source": "/og/:key", "destination": "/api/og?k=:key" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }
      ]
    }
  ]
}
